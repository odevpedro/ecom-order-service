{
  "info": {
    "name": "ecom-order-service",
    "description": "API de pedidos - orquestrador do ecommerce\n\nBase URL: {{base_url}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "ecom-order"
  },
  "item": [
    {
      "name": "Criar pedido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var json = pm.response.json();",
              "    pm.collectionVariables.set('order_id', json.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"user-stub-123\",\n  \"items\": [\n    {\n      \"productId\": \"prod-stub-456\",\n      \"sku\": \"NOTE-DELL-001\",\n      \"quantity\": 2\n    }\n  ],\n  \"street\": \"Rua das Flores\",\n  \"number\": \"100\",\n  \"neighborhood\": \"Centro\",\n  \"city\": \"Sao Paulo\",\n  \"state\": \"SP\",\n  \"zipCode\": \"01001000\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/orders",
          "host": ["{{base_url}}"],
          "path": ["api", "orders"]
        }
      }
    },
    {
      "name": "Listar pedidos por usuario",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/orders?userId=user-stub-123",
          "host": ["{{base_url}}"],
          "path": ["api", "orders"],
          "query": [{ "key": "userId", "value": "user-stub-123" }]
        }
      }
    },
    {
      "name": "Buscar pedido por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/orders/{{order_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "orders", "{{order_id}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:3003", "type": "string" },
    { "key": "order_id", "value": "", "type": "string" }
  ]
}
